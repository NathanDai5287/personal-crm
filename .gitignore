# Personal data — NEVER committed to this repo. Contains contacts' private
# message content (crm.db archive, profiles, ledgers), the dashboard password
# (web-password.txt), and the Signal DB cipher key (signal-key.txt). The data
# tree has its own separate, local-only git history (.memory-history.git).
data/

# Run logs (contain message excerpts in step notes)
logs/
# crm-web stdout/stderr redirect logs (created when running the web app detached)
crm-web.out.log
crm-web.err.log

# Local-only snapshot history of data/
.memory-history.git/

node_modules/
*.bak
*.tmp-*

# Local machine paths (names local install locations). .env.example is committed.
.env
