# Machine-specific paths for the personal-crm pipeline.
# Copy this file to `.env` and edit the values for your machine. `.env` is
# git-ignored; this template is committed. A real environment variable always
# overrides what's in `.env`.

# ── Repo root ──────────────────────────────────────────────────────────────
# Auto-detected from the code's own location; only set this if you run the
# scripts from an unusual layout.
# CRM_ROOT=/absolute/path/to/personal-crm

# ── Signal Desktop message database (required) ─────────────────────────────
# The encrypted SQLCipher DB the sweep reads from.
#   Windows: C:/Users/<you>/AppData/Roaming/Signal/sql/db.sqlite
#   macOS:   /Users/<you>/Library/Application Support/Signal/sql/db.sqlite
#   Linux:   /home/<you>/.config/Signal/sql/db.sqlite
CRM_SIGNAL_DB=C:/Users/<you>/AppData/Roaming/Signal/sql/db.sqlite

# ── pi coding-agent CLI (required for model steps) ─────────────────────────
# Path to the installed `pi` CLI entrypoint. Find it with:
#   npm root -g   →   <that>/@earendil-works/pi-coding-agent/dist/cli.js
CRM_PI_CLI=C:/Users/<you>/AppData/Roaming/npm/node_modules/@earendil-works/pi-coding-agent/dist/cli.js

# ── Signal key rederivation (Windows only) ─────────────────────────────────
# Used to rederive Signal's cipher key via Windows DPAPI. On macOS/Linux this
# path-based rederivation does not apply — seed data/signal-key.txt with the
# known key instead, and these two can be left unset.
CRM_SIGNAL_CONFIG=C:/Users/<you>/AppData/Roaming/Signal/config.json
CRM_SIGNAL_LOCAL_STATE="C:/Users/<you>/AppData/Roaming/Signal/Local State"
